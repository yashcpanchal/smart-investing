# Copy to .env and fill in. .env is gitignored.

# LLM keys — optional; the engine runs fully without either using deterministic
# fallbacks. Provider selection is plug-and-play (see llm/factory.py):
#   auto (default): Anthropic if its key is set, else Gemini, else no LLM.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Force a provider ("anthropic" | "gemini" | "none") or override the model.
# LLM_PROVIDER=auto
# LLM_MODEL=claude-opus-4-8

# SEC EDGAR requires a descriptive User-Agent (name + email) per their fair-access policy.
SEC_USER_AGENT=smart-investing yourname@example.com

# Robinhood Agentic MCP (Phase 11 — not used yet). The agent connects to THIS
# server; we are the client/host. OAuth onboarding is desktop-only.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading

# Copy to .env and fill in. .env is gitignored.

# Optional — only needed for the LLM-driven phases (Phase 5 relation extraction,
# Phase 6 prompt -> StrategySpec). The engine runs fully without it using a
# deterministic fallback parser.
ANTHROPIC_API_KEY=

# SEC EDGAR requires a descriptive User-Agent (name + email) per their fair-access policy.
SEC_USER_AGENT=smart-investing yourname@example.com

# Robinhood Agentic MCP (Phase 11 — not used yet). The agent connects to THIS
# server; we are the client/host. OAuth onboarding is desktop-only.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
